# Copy to .env and fill in from your Supabase project (Settings -> API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL this app is served from. Used for email verification / password
# reset redirect links. Must be in the Supabase Auth redirect allow-list.
VITE_SITE_URL=http://localhost:5173
